# Token của bot (Discord Developer Portal -> Bot -> Reset Token)
DISCORD_TOKEN=

# Application ID (Developer Portal -> General Information)
CLIENT_ID=

# (Tuỳ chọn) Đăng ký slash command tức thì cho 1 guild khi dev.
# Để trống = đăng ký toàn cục (có thể mất tới 1 giờ mới hiển thị).
GUILD_ID=

# (Tuỳ chọn) Tên role mute mặc định. Có thể đổi bằng /config set-mute-role.
MUTE_ROLE_NAME=Muted

# (Tuỳ chọn) Kênh nhận mod log mặc định, dùng khi /setup không truyền kênh.
MOD_LOG_CHANNEL_ID=

# (Tuỳ chọn) Đường dẫn file SQLite. Mặc định ./data/bot.sqlite
# DB_PATH=./data/bot.sqlite
