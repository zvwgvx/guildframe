{
  "name": "moderation-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Discord moderation bot — mute theo role, cảnh cáo, offence count, lịch sử punishment, audit log",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=23.4.0"
