{
  "name": "moderation-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Discord moderation bot - role-based mutes, warnings, offence count, punishment history, audit log",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=23.4.0"
  },
  "scripts": {
    "start": "node --env-file=.env src/index.js",
    "dev": "node --watch --env-file=.env src/index.js",
    "deploy": "node --env-file=.env src/deploy-commands.js",
    "ids": "node --env-file=.env scripts/list-ids.js"
  },
  "dependencies": {
    "discord.js": "^14.27.0"
  }
}
